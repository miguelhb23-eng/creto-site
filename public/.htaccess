# ── CRETO · configuración Apache para Hostinger ──────────────

RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# URLs sin extensión: /servicios -> /servicios.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Página 404 personalizada
ErrorDocument 404 /404.html

# No mostrar listados de carpetas
Options -Indexes

# El archivo interno de la publicación automática no debe ser público
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# ── Compresión ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2

# ── Caché ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Archivos de /assets/ llevan una huella en el nombre (p. ej. layout-D_2an615.css):
  # cuando cambian, cambia el nombre. Se pueden guardar un año sin riesgo.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Las páginas se revisan siempre, para que los cambios se vean al publicar.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Logos, íconos e imágenes sin huella: una semana.
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ── Seguridad básica ────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
